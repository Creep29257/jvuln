# /usr/local/etc/jvuln.conf - plain sh syntax (VAR=value). Everything is optional.
# Precedence: command line (-o) > environment > this file > built-in default.

#LANG_UI=en                    # en | fr
#TITLE="jvuln - myhost"
#OUT_DIR=/var/db/jvuln         # directory where the page is written (default)
#OUT_NAME="jvuln-%Y%m%d.html"  # file name, date(1) format (default: one file per day)
#LATEST_LINK=jvuln-latest.html # symlink to the newest page; set empty to disable
#FILE_MODE=644                 # use 640/600 to restrict who can read it
#FILE_OWNER=root:wheel
#
# Example: drop the page where a jail can read it (no web server needed):
#OUT_DIR=/usr/local/bastille/jails/management/root/usr/local/share/jvuln

# Which jails
#JAIL_SOURCE=auto              # auto | bastille | jls (jls = running jails only)
#INCLUDE_HOST=yes              # yes | no
#EXCLUDE_JAILS="test-* old"    # sh patterns, space-separated
#ONLY_JAILS=""                 # whitelist; empty = all

#BASTILLE=/usr/local/bastille  # Bastille prefix, used for jail discovery

#VULNDB=/var/db/pkg/vuln.xml
